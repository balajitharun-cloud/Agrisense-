# AgriSense environment — every variable is OPTIONAL.
# The app runs fully with no keys at all (all data is simulated locally).
# Copy this file to .env and fill in what you have. Never commit .env.

# Port the Express server listens on. Default: 8787
PORT=8787

# --- Voice (text to speech) -----------------------------------------------
# When set, POST /api/voice/tts proxies to ElevenLabs and streams audio/mpeg
# back to the browser; the key never reaches the client. When unset, the UI
# falls back to the browser's Web Speech API silently.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- Weather ---------------------------------------------------------------
# Live weather always uses Open-Meteo (no key needed). Set an OpenWeatherMap
# key to prefer OWM when running (reserved upgrade path).
OPENWEATHER_API_KEY=

# --- Satellite soil indices ------------------------------------------------
# Sentinel Hub OAuth client credentials. When both are set the backend can
# request live statistical API data; otherwise seeded simulation is served.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# --- Marketplace -----------------------------------------------------------
# Optional external marketplace feed. Unset = in-memory demo listings.
MARKETPLACE_API_BASE=
MARKETPLACE_API_KEY=

# --- Government advisories -------------------------------------------------
# Optional external RSS/JSON feed of announcements. Unset = in-memory feed.
GOV_FEED_URL=

# --- Translation -----------------------------------------------------------
# Optional external translation provider. Unset = curated phrase dictionary
# with graceful fallback to English.
TRANSLATE_API_KEY=

# --- AI (pest photo identification + smart advisory) -----------------------
# Optional provider keys for the AI features. Priority: Mistral > OpenAI >
# Gemini. When none is set, POST /api/ai/pest-identify degrades to 503 so the
# UI falls back to symptom matching, and POST /api/ai/advisory composes a
# rule-based advisory (source "simulated"). Never commit .env.
MISTRAL_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_VISION_MODEL=
AI_TEXT_MODEL=
